# Editor defaults for files the repository's formatters do not own.
# Go is formatted by gofmt and goimports (`make fmt`); YAML under api/ and
# compose.yaml by yamlfmt. The settings here only keep editors from fighting
# those tools and give the remaining file types a consistent baseline.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{bash,sh}]
indent_size = 2
