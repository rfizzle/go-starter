# Exact versions shared by local bootstrap, environment validation, and CI.
# Keep module paths beside versions so installers never fall back to @latest.
GOIMPORTS_MODULE=golang.org/x/tools/cmd/goimports
GOIMPORTS_VERSION=v0.47.0

GOLANGCI_LINT_MODULE=github.com/golangci/golangci-lint/v2/cmd/golangci-lint
GOLANGCI_LINT_VERSION=v2.12.2

YAMLFMT_MODULE=github.com/google/yamlfmt/cmd/yamlfmt
YAMLFMT_VERSION=v0.21.0

GORELEASER_MODULE=github.com/goreleaser/goreleaser/v2
GORELEASER_VERSION=v2.17.0

SYFT_MODULE=github.com/anchore/syft/cmd/syft
SYFT_VERSION=v1.49.0

SQLC_MODULE=github.com/sqlc-dev/sqlc/cmd/sqlc
SQLC_VERSION=v1.31.1

GOOSE_MODULE=github.com/pressly/goose/v3/cmd/goose
GOOSE_VERSION=v3.27.2

GOVULNCHECK_MODULE=golang.org/x/vuln/cmd/govulncheck
GOVULNCHECK_VERSION=v1.1.4
