# GoReleaser supplies one prebuilt static binary per TARGETPLATFORM.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6

ARG TARGETPLATFORM

COPY --chown=nonroot:nonroot ${TARGETPLATFORM}/starter /app

USER nonroot:nonroot

EXPOSE 8080

ENTRYPOINT ["/app"]
CMD ["serve"]
