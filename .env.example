# Local development only. Do not reuse these values in a deployed environment.
GOSTARTER_ENVIRONMENT=development
GOSTARTER_DATABASE_URI=postgres://gostarter:gostarter@localhost:5432/gostarter?sslmode=disable
GOSTARTER_DATABASE_AUTO_MIGRATE=false
GOSTARTER_SEED_EMAIL=admin@example.com
GOSTARTER_SEED_FIRST_NAME=Admin
GOSTARTER_SEED_LAST_NAME=User
# Optional: omit to generate and display a random password only when the user is created.
# GOSTARTER_SEED_PASSWORD=
GOSTARTER_AUTH_JWT_SECRET=local-development-secret-change-me
# Login attempts are limited per process and client IP.
GOSTARTER_RATE_LIMIT_MAX_REQUESTS=5
GOSTARTER_RATE_LIMIT_WINDOW=60
GOSTARTER_RATE_LIMIT_MAX_KEYS=10000
GOSTARTER_RATE_LIMIT_CLEANUP_INTERVAL=60
# Trust forwarding headers only from reverse proxies you operate. Use canonical CIDRs.
# GOSTARTER_RATE_LIMIT_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
GOSTARTER_LOGGING_LEVEL=debug
GOSTARTER_LOGGING_FORMAT=console
GOSTARTER_WEBSERVER_ADDRESS=127.0.0.1
GOSTARTER_WEBSERVER_PORT=8080
