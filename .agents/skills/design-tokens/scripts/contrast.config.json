{
  "$comment": "Explicit contrast contract. Each pairing is enforced in every theme. level: text=4.5:1, large=3:1, ui=3:1. Add a pairing whenever you add a foreground/background semantic token — a new token with no declared pairing is an ungoverned decision. fg/bg are the names AFTER the --color- prefix.",
  "requiredThemes": ["dark"],
  "ignoreThemes": [],
  "pairs": [
    { "fg": "fg",        "bg": "surface",        "level": "text" },
    { "fg": "fg",        "bg": "surface-raised", "level": "text" },
    { "fg": "fg",        "bg": "surface-sunken", "level": "text" },
    { "fg": "fg",        "bg": "surface-overlay", "level": "text" },
    { "fg": "fg-muted",  "bg": "surface",        "level": "text", "note": "secondary body text; downgrade to 'large' only if it is exclusively >=24px" },
    { "fg": "fg-on-brand", "bg": "brand",        "level": "text" },
    { "fg": "danger-fg", "bg": "danger",         "level": "text" },
    { "fg": "warning-fg", "bg": "warning",       "level": "text" },
    { "fg": "success-fg", "bg": "success",       "level": "text" },
    { "fg": "info-fg",    "bg": "info",          "level": "text" },
    { "fg": "brand",      "bg": "brand-muted",   "level": "text" },
    { "fg": "danger",     "bg": "danger-muted",  "level": "text" },
    { "fg": "warning-fg", "bg": "warning-muted", "level": "text" },
    { "fg": "success",    "bg": "success-muted", "level": "text" },
    { "fg": "info",       "bg": "info-muted",    "level": "text" },
    { "fg": "border",    "bg": "surface",        "level": "ui",   "note": "non-text UI boundary" },
    { "fg": "border-strong", "bg": "surface",     "level": "ui",   "note": "strong non-text UI boundary" },
    { "fg": "focus",     "bg": "surface",        "level": "ui",   "note": "focus ring must be visible against the surface it sits on" },
    { "fg": "focus",     "bg": "surface-raised", "level": "ui" },
    { "fg": "focus",     "bg": "surface-sunken", "level": "ui" }
  ]
}
